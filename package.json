{
  "name": "muse-bar",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vp preview",
    "build-only": "vp build",
    "type-check": "vue-tsc --build",
    "lint": "vp lint . --fix",
    "format": "vp fmt src/",
    "prepare": "vp config",
    "release": "release-it",
    "rust:format": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:check": "cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets -- -D warnings",
    "rust:fix": "cargo clippy --manifest-path src-tauri/Cargo.toml --fix --workspace --all-targets --allow-dirty --allow-staged"
  },
  "dependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@lucide/vue": "^1.31.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion-v": "^2.4.0",
    "pinia": "^4.0.2",
    "reka-ui": "^2.10.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@release-it/bumper": "8.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.2",
    "release-it": "21.0.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "catalog:",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vite-plus": "catalog:",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.21.0 || >=24.12.0"
  }
}
