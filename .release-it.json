{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "git": {
    "requireBranch": "main",
    "requireCleanWorkingDir": true,
    "requireUpstream": true,
    "requireCommits": true,
    "getLatestTagFromAllRefs": true,
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "Release v${version}",
    "pushArgs": ["--atomic", "--follow-tags"]
  },
  "npm": false,
  "github": {
    "release": false
  },
  "plugins": {
    "@release-it/bumper": {
      "in": "src-tauri/tauri.conf.json",
      "out": [
        "package.json",
        "src-tauri/tauri.conf.json",
        {
          "file": "src-tauri/Cargo.toml",
          "path": "package.version"
        }
      ]
    }
  },
  "hooks": {
    "before:init": [
      "git fetch origin --tags --force --prune",
      "vp check",
      "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check"
    ],
    "before:bump": "node scripts/validate-release-version.mjs ${latestVersion} ${version}",
    "after:bump": "cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets -- -D warnings"
  }
}
