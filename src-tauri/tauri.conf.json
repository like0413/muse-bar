{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Muse Bar",
  "version": "0.1.0",
  "identifier": "com.musebar.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "vp dev",
    "beforeBuildCommand": "vp build"
  },
  "app": {
    "windows": [
      {
        "label": "bar",
        "create": false,
        "title": "Muse Bar",
        "url": "index.html#/bar",
        "width": 360,
        "height": 48,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true
      },
      {
        "label": "settings",
        "create": false,
        "title": "Muse Bar 设置",
        "url": "index.html#/settings",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Windows 11 taskbar media controller",
    "longDescription": "Muse Bar shows and controls the current Windows media session from the Windows 11 taskbar.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
