{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Muse Bar",
  "version": "0.1.0",
  "identifier": "com.musebar.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "vp dev",
    "beforeBuildCommand": "vp build"
  },
  "app": {
    "windows": [
      {
        "title": "Muse Bar",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Windows 11 taskbar media controller",
    "longDescription": "Muse Bar shows and controls the current Windows media session from the Windows 11 taskbar.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
