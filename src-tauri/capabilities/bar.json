{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "bar",
  "description": "Allows the Bar window to create or focus the settings window",
  "windows": ["bar"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-show",
    "core:window:allow-set-focus"
  ]
}
